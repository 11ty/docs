{#- Build Awesome corner flag, links to the matching page when the sister sitemap has one. #}
{%- set cornerMatched = page.url in sisterSite.urls %}
{%- set cornerLogoCss %}
:host {
	display: block;
	position: fixed;
	inset-block-end: 0;
	inset-inline-end: 0;
	width: 92px;
	height: 92px;
	background-color: var(--brand-ba, #00a776);
	clip-path: polygon(100% 0, 100% 100%, 0 100%);
	z-index: 1;
	transition: background-color .2s ease-out;
}
:host([matched]) {
	width: 120px;
	height: 120px;
}
:host(:hover),
:host(:focus-within) {
	background-color: #222;
}
/* Only when the viewport is wide enough to keep it clear of the 70rem layout. */
@media (max-width: 85.9375em) {
	:host {
		display: none;
	}
}
::slotted(a) {
	position: absolute;
	inset: 0;
}
.label {
	position: absolute;
	top: 57%;
	left: 57%;
	transform: translate(-50%, -50%) rotate(-45deg);
	white-space: nowrap;
	font-size: 11px;
	font-weight: 700;
	line-height: 1;
	letter-spacing: .02em;
	color: #fff;
	pointer-events: none;
}
.logo {
	position: absolute;
	inset-block-end: 10px;
	inset-inline-end: 10px;
	width: 32px;
	height: 32px;
	color: #fff;
	pointer-events: none;
}
.logo svg {
	display: block;
	width: 100%;
	height: 100%;
}
{% endset %}
<corner-logo{% if cornerMatched %} matched{% endif %}>
	<template shadowrootmode="open">
		<style>{{ cornerLogoCss | cssmin | safe }}</style>
		<slot></slot>
		{%- if cornerMatched %}
		<span class="label" aria-hidden="true">This page in v4 →</span>
		{%- endif %}
		<span class="logo">{% include "components/ba-balloon.svg" %}</span>
	</template>
	<a href="{{ sisterSite.origin }}{{ page.url if cornerMatched else '/' }}" class="nound elv-externalexempt"><span class="sr-only">{% if cornerMatched %}This page on Build Awesome{% else %}Build Awesome{% endif %}</span></a>
</corner-logo>
