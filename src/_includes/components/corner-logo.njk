{#- 11ty corner flag, after the one in /img/open-graph.jpg (see also .og-flag in opengraph.njk), links to the matching page when the sister sitemap has one. #}
{%- set cornerMatched = page.url in sisterSite.urls %}
{%- set cornerLogoCss %}
:host {
	display: block;
	position: fixed;
	inset-block-end: 0;
	inset-inline-end: 0;
	width: 92px;
	height: 92px;
	background-color: #222;
	clip-path: polygon(100% 0, 100% 100%, 0 100%);
	z-index: 1;
	transition: background-color .2s ease-out;
}
:host([matched]) {
	width: 120px;
	height: 120px;
}
:host(:hover),
:host(:focus-within) {
	background-color: var(--brand-ba, #00a776);
}
/* Only when the viewport is wide enough to keep it clear of the 70rem layout. */
@media (max-width: 85.9375em) {
	:host {
		display: none;
	}
}
::slotted(a) {
	position: absolute;
	inset: 0;
}
.label {
	position: absolute;
	top: 57%;
	left: 57%;
	transform: translate(-50%, -50%) rotate(-45deg);
	white-space: nowrap;
	font-size: 11px;
	font-weight: 700;
	line-height: 1;
	letter-spacing: .02em;
	color: #fff;
	pointer-events: none;
}
.logo {
	position: absolute;
	inset-block-end: 11px;
	inset-inline-end: 15px;
	width: 28.5px;
	height: 23.25px;
	/* Crops the padding out of the logo.svg viewBox. */
	background-image: url("/img/logo.svg");
	background-size: 39.6px 55.1px;
	background-position: -5.5px -15.5px;
	background-repeat: no-repeat;
	pointer-events: none;
}
{% endset %}
<corner-logo{% if cornerMatched %} matched{% endif %}>
	<template shadowrootmode="open">
		<style>{{ cornerLogoCss | cssmin | safe }}</style>
		<slot></slot>
		{%- if cornerMatched %}
		<span class="label" aria-hidden="true">This page in v3 →</span>
		{%- endif %}
		<span class="logo"></span>
	</template>
	<a href="{{ sisterSite.origin }}{{ page.url if cornerMatched else '/' }}" class="nound elv-externalexempt"><span class="sr-only">{% if cornerMatched %}This page on 11ty{% else %}11ty{% endif %}</span></a>
</corner-logo>
