{#- Build Awesome corner flag. #}
{%- set cornerLogoCss %}
:host {
	display: block;
	position: fixed;
	inset-block-end: 0;
	inset-inline-end: 0;
	width: 92px;
	height: 92px;
	background-color: var(--brand-ba, #00a776);
	clip-path: polygon(100% 0, 100% 100%, 0 100%);
	z-index: 1;
	transition: background-color .2s ease-out;
}
:host(:hover),
:host(:focus-within) {
	background-color: #222;
}
/* Only when the viewport is wide enough to keep it clear of the 70rem layout. */
@media (max-width: 85.9375em) {
	:host {
		display: none;
	}
}
::slotted(a) {
	position: absolute;
	inset: 0;
}
.logo {
	position: absolute;
	inset-block-end: 10px;
	inset-inline-end: 10px;
	width: 32px;
	height: 32px;
	color: #fff;
	pointer-events: none;
}
.logo svg {
	display: block;
	width: 100%;
	height: 100%;
}
{% endset %}
<corner-logo>
	<template shadowrootmode="open">
		<style>{{ cornerLogoCss | cssmin | safe }}</style>
		<slot></slot>
		<span class="logo">{% include "components/ba-balloon.svg" %}</span>
	</template>
	<a href="https://build.awesome.me/" class="nound elv-externalexempt"><span class="sr-only">Build Awesome</span></a>
</corner-logo>
