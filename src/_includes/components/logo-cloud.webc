<div :class="marquee !== undefined ? 'logo-marquee' : false">
<ul class="logos-list" webc:for="copy of (marquee !== undefined ? [1, 2] : [1])" :id="copy === 1 ? 'logos' : false" :aria-hidden="copy === 2 ? 'true' : false">
	<li><img webc:is="indieweb-avatar" url="https://www.nasa.gov/"><abbr title="National Aeronautics and Space Administration">NASA</abbr></li>
	<li><img webc:is="indieweb-avatar" url="https://home.web.cern.ch/">Cern</li>
	<li><img webc:is="indieweb-avatar" url="https://tc39.es/">TC39</li>
	<li><img src="/img/logos/w3c.png" width="150" height="150" alt="" class="avatar" loading="lazy" decoding="async">W3C</li>
	<li><img webc:is="indieweb-avatar" url="https://about.google/">Google</li>
	<li><img webc:is="indieweb-avatar" url="https://www.microsoft.com/">Microsoft</li>
	<li><img webc:is="indieweb-avatar" url="https://www.mozilla.org/">Mozilla</li>
	<li><img webc:is="indieweb-avatar" url="https://fontawesome.com/">Font Awesome</li>
	<li><img webc:is="indieweb-avatar" url="https://apache.org/">Apache</li>
	<li><img webc:is="indieweb-avatar" url="https://www.freecodecamp.org/">freeCodeCamp</li>
	<li>
		<html-fetch src="/imports/logo-cloud.html" target="li" replace></html-fetch>
	</li>
	<li class="logos-list-more">…and more</li>
</ul>
</div>
