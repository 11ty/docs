```js js
export const data = {
	pagination: {
		data: "globalDataSet.myData",
		size: 1,
	},
};

export function render(data) {
	return `<ol>
    ${data.pagination.items
			.map(function (item) {
				return `<li>${item}</li>`;
			})
			.join("")}
  </ol>`;
};
```
