```js js
export const data = {
	pagination: {
		data: "testdata",
		size: 1,
	},
	testdata: {
		itemkey1: "itemvalue1",
		itemkey2: "itemvalue2",
		itemkey3: "itemvalue3",
	},
};

export function render(data) {
	return `<ol>
		${data.pagination.items
			.map(function (item) {
				return `<li>${(item = data.testdata[item])}</li>`;
			})
			.join("")}
	</ol>`;
};
```
