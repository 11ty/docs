```js js
export const data = {
  pagination: {
    data: "testdata",
    size: 2,
    alias: "wonder"
  },
  testdata: [
    "Item1",
    "Item2",
    "Item3",
    "Item4"
  ],
  permalink: {
    function(data) {
      return `different/${this.slugify(data.wonder[0])}/index.html`
    }
  }
};

export function render(data) {
  return `You can use the alias in your content too ${data.wonder[0]}.`;
}
```
