```js jscjs
// Don’t forget to `npm install @iarna/toml`
const toml = require("@iarna/toml");

module.exports = function (eleventyConfig) {
	eleventyConfig.setFrontMatterParsingOptions({
		engines: {
			toml: toml.parse.bind(toml),
		},
	});
};
```
