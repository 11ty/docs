<?xml version="1.0" encoding="UTF-8"?>
<OpenSearchDescription
	xmlns="http://a9.com/-/spec/opensearch/1.1/"
	xmlns:moz="http://www.mozilla.org/2006/browser/search/">
	<ShortName>Build Awesome</ShortName>
	<LongName>Build Awesome (11ty)</LongName>
	<Description>Search for things on the Build Awesome website</Description>
	<InputEncoding>UTF-8</InputEncoding>
	<!-- <Image width="16" height="16"
	type="image/png">{{ config.origin }}/img/favicon-16.png</Image> -->
	<Image width="96" height="96" type="image/png">{{ config.origin }}/img/favicon.png</Image>
	<Url type="text/html" method="get" template="{{ config.origin }}/docs/search/?q={searchTerms}" />
	<Url type="application/opensearchdescription+xml" rel="self"
		template="{{ config.origin }}/opensearch.xml" />
	<moz:SearchForm>{{ config.origin }}/</moz:SearchForm>
</OpenSearchDescription>